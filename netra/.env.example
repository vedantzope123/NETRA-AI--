# NETRA Environment Configuration (100% Free-Tier Architecture)

# Gemini API Free-Tier Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Server & JWT Authentication Secret Key
JWT_SECRET=netra-super-secret-production-key-change-in-prod-2026

# Database Connection (SQLite for local demo, Supabase PostgreSQL free tier for deployment)
DATABASE_URL=sqlite:///./netra.db

# Server Host and Port
PORT=8000
HOST=0.0.0.0
